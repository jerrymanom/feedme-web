# Imagen de desarrollo — servidor Vite con hot-reload
FROM node:22-alpine

WORKDIR /app

# Instala dependencias primero para aprovechar la caché de capas
COPY package.json package-lock.json ./
RUN npm ci

# El código se monta como volumen en docker-compose (hot-reload)
COPY . .

EXPOSE 5173

# --host expone el server fuera del contenedor
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
